<Application x:Class="PigeonUnifierTSL.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="LogNormal" Color="#FFD23F"/>
            <SolidColorBrush x:Key="LogInfo" Color="#4FC3F7"/>
            <SolidColorBrush x:Key="LogPlugin" Color="#A78BFA"/>
            <SolidColorBrush x:Key="LogWarn" Color="#F59E0B"/>
            <SolidColorBrush x:Key="LogError" Color="#EF4444"/>
            <SolidColorBrush x:Key="LogOk" Color="#22C55E"/>
            <SolidColorBrush x:Key="LogCmd" Color="#4C8DF6"/>
            <SolidColorBrush x:Key="LogDim" Color="#9B97B8"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
