<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pigeon.UnifierTSL.Manager</AssemblyName>
    <RootNamespace>PigeonUnifierTSL.Manager</RootNamespace>
    <AssemblyTitle>Pigeon UnifierTSL Manager</AssemblyTitle>
    <Product>Pigeon UnifierTSL Manager</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <None Update="manager.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
